atozgrowth.net, www.atozgrowth.net {
    log {
        output stdout
        format json
    }
    encode zstd gzip
    @api path /api /api/*
    handle @api {
        reverse_proxy atoz_backend:3000
    }
    handle {
        reverse_proxy atoz_frontend:8080
    }
}

api.atozgrowth.net {
    log {
        output stdout
        format json
    }
    encode zstd gzip
    reverse_proxy atoz_backend:3000
}
